# Supabase → Project Settings → Database → Connection string.
# Runtime connection (Session pooler, port 5432). Don't add sslmode; SSL is configured in lib/prisma.js.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Used by `prisma migrate deploy`. The session pooler URL works here too.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Optional: Supabase's CA certificate (Database → SSL Configuration) to verify the server.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

JWT_SECRET="<long random string>"
PORT=5001

# Comma-separated origins allowed to call this API (the admin site). Required in production; unset = any origin.
# CORS_ORIGINS=https://admin.example.com

# Only for `npm run db:seed`, which creates the admin login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<at least 8 characters>"
