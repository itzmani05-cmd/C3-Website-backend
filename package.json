    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "8.23.1",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
