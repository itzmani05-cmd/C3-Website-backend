{
  "name": "admin-panel-backend",
  "version": "1.0.0",
  "description": "Admin Panel Backend for Question Bank Management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "prisma generate",
